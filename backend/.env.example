# MongoDB
MONGO_URI=mongodb://localhost:27017/snapshop

# Server
PORT=4000

# JWT
JWT_SECRET=your-jwt-secret-change-in-production

# Google APIs
GOOGLE_VISION_API_KEY=your-google-vision-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# SerpAPI (Google Shopping)
SERPAPI_KEY=your-serpapi-key
# Optional backward compatibility (legacy key name)
SEARCH_API_KEY=your-searchapi-key
# Optional quick search: merge extra Shopping blocks + paginate (each extra page uses API credits)
# SERP_SHOPPING_MAX_PAGES=4
# SERP_SHOPPING_MAX_PRODUCTS=60
