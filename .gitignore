# ================================
# Snap&Shop Git Ignore
# ================================

# Environment variables / secrets
.env
.env.*
!.env.example

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/

# Python tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editors
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp

# Jupyter
.ipynb_checkpoints/

# Build / distribution
dist/
build/
*.egg-info/

# Frontend build output
frontend/dist/
frontend/build/
frontend/.next/
frontend/.vite/

# Backend temporary files
backend/uploads/
backend/tmp/
backend/temp/

# AI / ML generated files
models/
checkpoints/
weights/
*.pt
*.pth
*.onnx
*.h5
*.keras
*.safetensors

# Datasets / generated data
datasets/
data/
*.csv
*.parquet
*.jsonl

# Caches
.cache/
__cache__/

# Local databases
*.db
*.sqlite
*.sqlite3

# Coverage
.coverage.*
coverage.xml

# Secrets / credentials
*.pem
*.key
*.crt
credentials.json
service-account.json
secrets.json